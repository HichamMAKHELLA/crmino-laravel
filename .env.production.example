# CRMino — configuration de PRODUCTION (§12). Copier en `.env` sur le serveur,
# puis renseigner les secrets. NE JAMAIS committer le `.env` réel.

APP_NAME=CRMino
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.imrasoft.ma

# Interface en français.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Journaux : quotidiens, 14 jours conservés, niveau warning en production.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# MariaDB (cPanel). L'utilisateur n'a que les droits sur SA base.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_crmino
DB_USERNAME=cpaneluser_crmino
DB_PASSWORD=

# Sur mutualisé cPanel : tout en base, pas de Redis à gérer.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log

# Documents (§44) : disque PRIVÉ, hors de la racine web servie.
FILESYSTEM_DISK=local

# Courriel (à renseigner selon l'hébergeur ; les notifications §36 restent en base).
MAIL_MAILER=smtp
MAIL_HOST=mail.imrasoft.ma
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="crm@imrasoft.ma"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
